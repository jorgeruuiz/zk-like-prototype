# Copia este fichero como .env.docker y cambia los valores antes de un despliegue compartido.
DOCKER_DB_USER=zkp
DOCKER_DB_PASSWORD=replace-with-a-random-password
DOCKER_DB_NAME=server_zkp
DOCKER_AUTH_SESSION_SECRET=replace-with-a-long-random-secret
APP_PORT=3000

# Trazas opcionales:
ZKP_TRACE=0
ZKP_TRACE_LEVEL=flow
