# Copia este fichero como .env para la ejecución local y sustituye los valores de ejemplo.
DB_USER=postgres
DB_PASSWORD=change-this-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=server_zkp
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000

# Trazas opcionales:
ZKP_TRACE=0
ZKP_TRACE_LEVEL=flow
