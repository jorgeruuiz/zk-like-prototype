' ==========================
' Estilo para SECUENCIAS UML
' ==========================

skinparam monochrome false
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 12
skinparam sequenceMessageAlign center

' Flechas y mensajes
skinparam ArrowColor #C2185B
skinparam ArrowThickness 1.3
skinparam ArrowFontColor #111111

' Participantes / actores
skinparam ParticipantBorderColor #C2185B
skinparam ParticipantBackgroundColor #FFF8DC
skinparam ParticipantFontColor #111111
skinparam ActorBorderColor #C2185B
skinparam ActorFontColor #111111
skinparam ActorBackgroundColor #FFF8DC

' Líneas de vida verticales
skinparam LifeLineBorderColor #D6A700
skinparam LifeLineBackgroundColor #FFF8DC
skinparam SequenceLifeLineBorderColor #D6A700
skinparam SequenceLifeLineBackgroundColor #FFF8DC

' Barras de activación
skinparam ActivationBorderColor #D6A700
skinparam ActivationBackgroundColor #FFF3B0

' Activations
skinparam ActivationBorderColor #C2185B
skinparam ActivationBackgroundColor #FCE4EC

' Grupos: loop, alt, opt
skinparam SequenceGroupBorderColor #333333
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceGroupHeaderFontColor #111111
skinparam SequenceGroupFontColor #111111

' Separadores tipo == Preparación ==
skinparam SequenceDividerBorderColor #333333
skinparam SequenceDividerBackgroundColor #EEEEEE
skinparam SequenceDividerFontColor #111111

' Notas
skinparam NoteBorderColor #E67E22
skinparam NoteBackgroundColor #FFF59D
skinparam NoteFontColor #111111

' Bases de datos y objetos
skinparam DatabaseBorderColor #444444
skinparam DatabaseBackgroundColor #FFF3CD
skinparam DatabaseFontColor #111111

skinparam CollectionsBorderColor #C2185B
skinparam CollectionsBackgroundColor #FFF8DC
skinparam CollectionsFontColor #111111

skinparam QueueBorderColor #C2185B
skinparam QueueBackgroundColor #FFF8DC
skinparam QueueFontColor #111111

skinparam EntityBorderColor #C2185B
skinparam EntityBackgroundColor #FFF8DC
skinparam EntityFontColor #111111

skinparam ControlBorderColor #C2185B
skinparam ControlBackgroundColor #FFF8DC
skinparam ControlFontColor #111111

skinparam BoundaryBorderColor #C2185B
skinparam BoundaryBackgroundColor #FFF8DC
skinparam BoundaryFontColor #111111
