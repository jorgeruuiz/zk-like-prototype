skinparam DatabaseBorderColor #444444
skinparam DatabaseBackgroundColor #FFF8DC
skinparam DatabaseFontColor black

skinparam NodeBorderColor #444444
skinparam NodeBackgroundColor #FFFFFF
skinparam NodeFontColor black

skinparam ArtifactBorderColor #C2185B
skinparam ArtifactBackgroundColor #FFF8DC
skinparam ArtifactFontColor black

